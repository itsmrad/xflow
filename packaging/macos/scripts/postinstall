#!/bin/sh
# Start the xflow background worker for the logged-in user, then open guided setup.
user=$(stat -f%Su /dev/console)
[ "$user" = root ] || [ -z "$user" ] && exit 0
uid=$(id -u "$user"); home=$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{print $2}')
# Older copies in ~/.local/bin would shadow /usr/local/bin on PATH; set them aside.
old="$home/.local/bin"
if [ -e "$old/xflow" ] || [ -e "$old/xflowd" ]; then
    keep="$home/.local/share/xflow-backup/replaced-$(date +%Y%m%d-%H%M%S)"
    sudo -u "$user" mkdir -p "$keep"
    for b in xflow xflowd; do [ -e "$old/$b" ] && mv "$old/$b" "$keep/"; done
fi
launchctl asuser "$uid" sudo -u "$user" HOME="$home" /usr/local/bin/xflow service install --enable || true
# Guided setup opens System Settings at each permission xflowd still needs.
launchctl asuser "$uid" sudo -u "$user" /usr/bin/open -a Terminal "/usr/local/share/xflow/Set up xflow.command" || true
exit 0
