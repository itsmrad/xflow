# Maintainer: xflow contributors
# Binary package from the GitHub release tarballs. Not published to the AUR yet.
# Bump: set _tag, pkgver (the tag without "v" and "-", so betas sort first) and both sums from SHA256SUMS.
pkgname=xflow-bin
_tag=v0.2.1-beta
pkgver=0.2.1beta
pkgrel=1
pkgdesc='Local-first voice typing for Linux desktops'
arch=(x86_64 aarch64)
url=https://github.com/itsmrad/xflow
license=(MIT)
depends=(alsa-lib dbus gcc-libs glibc)
optdepends=('wl-clipboard: Wayland clipboard and paste')
provides=(xflow)
conflicts=(xflow)
options=(!strip !debug)
install=xflow-bin.install
source_x86_64=("$url/releases/download/$_tag/xflow-${_tag#v}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$url/releases/download/$_tag/xflow-${_tag#v}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('63d2f34b0e159971d37a723fc1e87812e10eec64fb084e53fcdc55f63df672ee')
sha256sums_aarch64=('8aa28d0fbf104ff97f24207e65be8bb1ff83332f8137504401a71d304522d465')

package() {
    cd "xflow-${_tag#v}-$CARCH-unknown-linux-gnu"
    install -Dm755 -t "$pkgdir/usr/bin" xflow xflowd
    install -dm755 "$pkgdir/usr/lib/systemd/user"
    sed 's|^ExecStart=%h/\.local/bin/xflowd$|ExecStart=/usr/bin/xflowd|' packaging/xflow.service >"$pkgdir/usr/lib/systemd/user/xflow.service"
    grep -qx 'ExecStart=/usr/bin/xflowd' "$pkgdir/usr/lib/systemd/user/xflow.service"
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE SCOWL-LICENSE.txt BPE-LICENSE.txt
    install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
}
