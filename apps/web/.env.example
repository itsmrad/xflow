# Copy to .env.local. `clerk env pull` and `neon deploy` fill most of these.

# Clerk (clerk link --app app_3LKvjeu4Yu1wN08aYYmAnt0bhz5 && clerk env pull)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres (neon deploy). Pooled for the app, direct for migrations.
DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://.../neondb?sslmode=require
NEON_BRANCH=production

# Neon Realtime (neon deploy). The secret is server-only.
NEON_REALTIME_URL=wss://...
NEON_REALTIME_SECRET=
NEXT_PUBLIC_NEON_REALTIME_URL=$NEON_REALTIME_URL

# Neon Object Storage (neon deploy), bucket "releases" for CLI downloads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://...
AWS_REGION=ap-southeast-1

# Dodo Payments (dashboard → Developer). Test mode until launch.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_...
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRO_PRODUCT_ID=pdt_...

# Groq: xflow's central key for Pro hosted transcription. Server-only.
GROQ_API_KEY=
# Optional override of https://api.groq.com/openai/v1 (tests point it at a stub).
# GROQ_BASE_URL=

# Public origin for the device-flow verification URL and checkout return URL.
# On Vercel it defaults to the deployment URL; set it once a custom domain exists.
NEXT_PUBLIC_APP_URL=http://localhost:3000
